  flex-direction: column;
  width: 92px;
  padding: 12px 8px;
  border-radius: 8px;
  background-color: #151a22;
}
.metric-label {
  font-size: 18px;
  color: #8f98a8;
}
.metric-value {
  margin-top: 6px;
  font-size: 22px;
  color: #ffffff;
}
.section {
  flex-direction: column;
  margin: 0 16px 18px;
  padding: 14px;
  border-radius: 8px;
  background-color: #10151d;
}
.title {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}
.summary {
  margin-top: 10px;
  font-size: 20px;
  line-height: 28px;
  color: #b8c0cc;
}
.chips {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 14px;
}
.chip {
  width: 72px;
  height: 46px;
  margin-right: 8px;
  margin-bottom: 8px;
  border-radius: 8px;
  background-color: #232a35;
  color: #c7cfdb;
  font-size: 21px;
  text-align: center;
}
.active {
  background-color: #2f7df6;
  color: #ffffff;
}
.input {
  width: 300px;
  height: 58px;
  margin-top: 14px;
  padding: 0 14px;
  border-radius: 8px;
  background-color: #05070a;
  color: #ffffff;
  font-size: 20px;
}
.actions {
  flex-direction: row;
  margin-top: 14px;
}
.button {
  width: 130px;
  height: 48px;
  margin-right: 8px;
  border-radius: 8px;
  background-color: #2f7df6;
  color: #ffffff;
  font-size: 21px;
  text-align: center;
}
.ghost {
  background-color: #27303c;
}
.voice {
  background-color: #135f5b;
}
.full {
  width: 300px;
  margin-top: 14px;
}
.voice-status,
.ai-status {
  margin-top: 10px;
  font-size: 17px;
  color: #7db2ff;
}
.task {
  flex-direction: row;
  align-items: center;
  margin-top: 14px;
  padding: 10px;
  border-radius: 8px;
  background-color: #171e28;
}
.done {
  background-color: #12352c;
}
.time {
  width: 54px;
  font-size: 20px;
  color: #7db2ff;
}
.task-main {
  flex-direction: column;
  width: 230px;
}
.task-name {
  font-size: 22px;
  color: #ffffff;
}
.done-name {
  color: #9ee6b8;
}
.task-tip {
  margin-top: 5px;
  font-size: 17px;
  color: #96a1b1;
}
.review {
  margin-top: 12px;
  font-size: 20px;
  color: #9ee6b8;
}
</style>
