  flex-direction: column;
  width: 92px;
  padding: 12px 8px;
  border-radius: 8px;
  background-color: #151a22;
}
.metric-label {
  font-size: 18px;
  color: #8f98a8;
}
.metric-value {
  margin-top: 6px;
  font-size: 22px;
  color: #ffffff;
}
.section {
  flex-direction: column;
  margin: 0 16px 18px;
  padding: 14px;
  border-radius: 8px;
  background-color: #10151d;
}
.title {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}
.label {
  margin-top: 14px;
  font-size: 18px;
  color: #8f98a8;
}
.chips {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 10px;
}
.chip {
  width: 68px;
  height: 44px;
  margin-right: 8px;
  margin-bottom: 8px;
  border-radius: 8px;
  background-color: #232a35;
  color: #c7cfdb;
  font-size: 20px;
  text-align: center;
}
.weather-chip {
  width: 66px;
}
.active,
.selected {
  background-color: #2f7df6;
  color: #ffffff;
}
.input {
  width: 300px;
  height: 56px;
  margin-top: 14px;
  padding: 0 14px;
  border-radius: 8px;
  background-color: #05070a;
  color: #ffffff;
  font-size: 20px;
}
.compact {
  width: 180px;
}
.goal-preview {
  width: 300px;
  margin-top: 10px;
  font-size: 18px;
  line-height: 26px;
  color: #b8c0cc;
}
.voice-status,
.ai-status,
.hint,
.context,
.reminder,
.health-hint,
.progress {
  margin-top: 10px;
  font-size: 17px;
  line-height: 24px;
  color: #7db2ff;
}
.actions {
  flex-direction: row;
  margin-top: 14px;
}
.button,
.small-button {
  height: 48px;
  border-radius: 8px;
  background-color: #2f7df6;
  color: #ffffff;
  font-size: 20px;
  text-align: center;
}
.button {
  width: 130px;
  margin-right: 8px;
}
.small-button {
  width: 110px;
  padding-top: 12px;
  font-size: 18px;
}
.ghost {
  background-color: #27303c;
}
.voice {
  background-color: #135f5b;
}
.full {
  width: 300px;
  margin-top: 14px;
}
.setting-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 300px;
  margin-top: 14px;
}
.setting-label {
  font-size: 20px;
  color: #ffffff;
}
.summary {
  margin-top: 10px;
  font-size: 20px;
  line-height: 28px;
  color: #b8c0cc;
}
.context {
  color: #e3c27a;
}
.reminder {
  color: #9ee6b8;
}
.health-hint,
.progress {
  color: #c7cfdb;
}
.task {
  flex-direction: row;
  align-items: center;
  margin-top: 14px;
  padding: 10px;
  border-radius: 8px;
  background-color: #171e28;
}
.done {
  background-color: #12352c;
}
.time {
  width: 54px;
  font-size: 20px;
  color: #7db2ff;
}
.task-main {
  flex-direction: column;
  width: 230px;
}
.task-day,
.task-adjust,
.task-important {
  font-size: 16px;
  color: #8f98a8;
}
.task-name {
  font-size: 22px;
  color: #ffffff;
}
.done-name {
  color: #9ee6b8;
}
.task-tip {
  margin-top: 5px;
  font-size: 17px;
  color: #96a1b1;
}
.task-adjust {
  margin-top: 4px;
  color: #e3c27a;
}
.task-important {
  margin-top: 4px;
  color: #ffb86b;
}
.action-button {
  width: 142px;
}
.defer {
  background-color: #553a32;
}
