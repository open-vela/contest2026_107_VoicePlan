{
  "package": "com.velaplan.watch",
  "name": "VelaPlan",
  "versionName": "0.1.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "service.health"
    },
    {
      "name": "system.fetch"
    },
    {
      "name": "system.record"
    },
    {
      "name": "system.file"
    },
    {
      "name": "system.velaclaw"
    },
    {
      "name": "system.storage"
    }
  ],
  "permissions": [
    {
      "name": "hapjs.permission.HEALTH"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 390,
    "background": {
      "features": [
        "service.health"
      ]
    }
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      }
    }
  }
}
